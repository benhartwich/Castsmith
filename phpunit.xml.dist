<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <!-- Nur Code, der ohne WordPress läuft. -->
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src/Support</directory>
            <directory>src/Numbers</directory>
            <directory>src/Audio</directory>
            <directory>src/Voice</directory>
            <directory>src/Auphonic</directory>
            <directory>src/Podlove</directory>
        </include>
    </source>
</phpunit>
